# Public network identity only
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------------------------
# Database
#
# Local PostgreSQL for development and the integration suites. Not interchangeable with the hosted
# database below: the suites provision and drop four databases of their own, which a hosted single-
# database project has nowhere to put — `provisionTestDatabase` refuses a hosted hostname outright.
# ---------------------------------------------------------------------------------------------
DATABASE_URL=postgresql://tr4ce:tr4ce@localhost:5432/tr4ce

# Separate from DATABASE_URL on purpose: the substreams sink CLI rejects the postgresql:// scheme
# and accepts only psql:// or postgres://.
SUBSTREAMS_SINK_DSN=psql://tr4ce:tr4ce@localhost:5432/tr4ce?sslmode=disable

# Optional. Set to run the @tr4ce/db integration suite, which drops and rebuilds the schema it
# points at, so never point it at DATABASE_URL — and never at a hosted database.
TR4CE_TEST_DATABASE_URL=

# ---------------------------------------------------------------------------------------------
# Hosted database (Supabase) — only for the deployed API and web app
#
# Names match the Supabase dashboard so it is obvious which string each one is.
#
# Migrations, the data copy, and anything sending multi-statement SQL use the SESSION pooler. The
# migration runner sends whole files over the simple query protocol, which transaction mode does
# not carry.
SUPABASE_SESSION_POOLER=

# Transaction mode. For a serverless deployment of the API, where every invocation is a fresh
# connection — `createDatabase` already sets `prepare: false`, which is what this mode requires.
SUPABASE_TX_POOLER=

# `db.<ref>.supabase.co`. Reachable only over IPv6 unless the IPv4 add-on is bought, so the pooler
# hosts above are the portable choice.
SUPABASE_DIRECT_CONNECTION_STRING=

SUPABASE_URL=

# Public by design — this ships in the browser bundle. That is precisely why migration 0003 enables
# row-level security on every table: without it, this key reads the whole database through PostgREST.
SUPABASE_ANON_PUBLIC_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Secrets. Never prefix these with NEXT_PUBLIC_ and never send them to the browser: the service role
# bypasses row-level security entirely, which is the one thing standing between the anon key and
# your data.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------------------------
GRAPH_SUBSTREAMS_ENDPOINT=
GRAPH_API_KEY=
RPC_URL_ETHEREUM=
RPC_URL_BASE=

# Optional policy-draft provider; the app works without it
POLICY_LLM_PROVIDER=disabled
POLICY_LLM_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
