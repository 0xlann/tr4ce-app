# Public network identity only
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------------------------
# Database
#
# Local PostgreSQL for development and the integration suites. Not interchangeable with the hosted
# database below: the suites provision and drop four databases of their own, which a hosted single-
# database project has nowhere to put — `provisionTestDatabase` refuses a hosted hostname outright.
# ---------------------------------------------------------------------------------------------
DATABASE_URL=postgresql://tr4ce:tr4ce@localhost:5432/tr4ce

# Separate from DATABASE_URL on purpose: the substreams sink CLI rejects the postgresql:// scheme
# and accepts only psql:// or postgres://.
SUBSTREAMS_SINK_DSN=psql://tr4ce:tr4ce@localhost:5432/tr4ce?sslmode=disable

# Optional. Set to run the @tr4ce/db integration suite, which drops and rebuilds the schema it
# points at, so never point it at DATABASE_URL — and never at a hosted database.
TR4CE_TEST_DATABASE_URL=

# ---------------------------------------------------------------------------------------------
# Hosted database (Supabase) — only for the deployed API and web app
#
# Use the *session pooler* string from Project Settings → Database → Connection string → Session:
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Session mode, not the direct `db.<ref>.supabase.co` host: direct connections are IPv6-only unless
# the IPv4 add-on is bought, and the pooler answers on IPv4. Port 5432 (session), not 6543
# (transaction) — the migration runner sends multi-statement files over the simple query protocol,
# which transaction mode does not carry. A serverless deployment can use 6543 for the API alone;
# `createDatabase` already sets `prepare: false`, which is what transaction mode requires.
#
# Never commit the real value. Keep it in .env, which is gitignored.
SUPABASE_DATABASE_URL=

# Non-secret. Safe in the browser bundle, which is exactly why migration 0003 enables row-level
# security on every table: without it this key reads the whole database through PostgREST.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------------------------
GRAPH_SUBSTREAMS_ENDPOINT=
GRAPH_API_KEY=
RPC_URL_ETHEREUM=
RPC_URL_BASE=

# Optional policy-draft provider; the app works without it
POLICY_LLM_PROVIDER=disabled
POLICY_LLM_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
